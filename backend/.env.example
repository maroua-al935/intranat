PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/anam_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:3020
BACKEND_URL=http://localhost:5001
CORS_ORIGIN=http://localhost:3020
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads
PDF_UPLOAD_MAX_MB=50
IMAGE_MAX_SIZE=5242880
IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
DOCUMENT_MAX_SIZE=52428800
DOCUMENT_ALLOWED_TYPES=application/pdf
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# Optional initial accounts; accounts are created only when both values are set.
INITIAL_SUPERADMIN_USERNAME=
INITIAL_SUPERADMIN_PASSWORD=
INITIAL_USER_USERNAME=
INITIAL_USER_PASSWORD=

# Only used by serveravant.js.
LEGACY_INITIAL_ADMIN_USERNAME=
LEGACY_INITIAL_ADMIN_PASSWORD=
LEGACY_INITIAL_USER_USERNAME=
LEGACY_INITIAL_USER_PASSWORD=

# Only used by hash.js.
HASH_PASSWORD=
